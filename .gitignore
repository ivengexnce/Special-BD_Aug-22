# ── Dependencies ──────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ──────────────────────────────────────────────────────
/.next/
/out/
/build

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Vercel ────────────────────────────────────────────────────────────────────
.vercel

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/extensions.json

# ── Logs ──────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testing ───────────────────────────────────────────────────────────────────
/coverage

# ── Utility / temp scripts (not part of the app) ─────────────────────────────
convert_assets.js
fix_refs.js

# ── Keep tracked (explicit — do NOT add public/ or src/ here) ────────────────
# public/images/**  → tracked (webp + mp4 assets)
# src/**            → tracked (all source code)
